# Annotated example of stacks/iam/main.tf

# Managed policy scoped to ONE bucket (Terraform remote state).
module "s3_state_policy" {
  source  = "terraform-aws-modules/iam/aws//modules/iam-policy"
  version = "~> 6.0"

  name        = local.name_policy # "<project>-s3-state"
  description = "Least-privilege access to Terraform state bucket for ${local.name_user}"
  path        = "/"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "ListStateBucket"
        Effect = "Allow"
        Action = [
          "s3:ListBucket",
          "s3:GetBucketVersioning",
          "s3:GetBucketLocation",
        ]
        Resource = ["arn:aws:s3:::${var.s3_bucket_name}"]
      },
      {
        Sid    = "StateObjects"
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
        ]
        Resource = ["arn:aws:s3:::${var.s3_bucket_name}/*"]
      },
    ]
  })

  tags = local.common_tags
}

# Dedicated user: access key only (no console password).
module "s3_state_user" {
  source  = "terraform-aws-modules/iam/aws//modules/iam-user"
  version = "~> 6.0"

  name                 = local.name_user # "<project>-s3-state"
  force_destroy        = true           # allow destroy even if keys exist
  create_login_profile = false          # no AWS Console password
  create_access_key    = true           # Access Key ID + Secret

  # Attach the managed policy by ARN (map key is a stable attachment name).
  policies = {
    s3_state = module.s3_state_policy.arn
  }

  tags = merge(local.common_tags, { Name = local.name_user })
}

# outputs.tf (sensitive secret stays in state — fine for learning):
#   s3_state_user_name / s3_state_user_arn / s3_state_policy_arn
#   s3_state_access_key_id
#   s3_state_access_key_secret  (sensitive = true)
#
# stacks/s3 reads s3_state_user_arn via remote state and puts it in the
# bucket policy Principal.
