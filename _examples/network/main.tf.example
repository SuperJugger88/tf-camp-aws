# Annotated example of stacks/network/main.tf
# (condensed — the real file has the same structure)

locals {
  name_vpc = coalesce(var.vpc_name, "${var.project_name}-vpc")
  vpc_cidr = var.vpc_cidr # 10.42.0.0/16

  # Subnets are carved out of vpc_cidr with cidrsubnet(cidr, newbits, netnum).
  # /16 -> /20 subnets: 4 new bits, netnums 0..5 used:
  #   public   0,1  -> 10.42.0.0/20, 10.42.16.0/20
  #   private  2,3  -> 10.42.32.0/20, 10.42.48.0/20
  #   database 4,5  -> 10.42.64.0/20, 10.42.80.0/20
  public_subnets   = [cidrsubnet(local.vpc_cidr, 4, 0), cidrsubnet(local.vpc_cidr, 4, 1)]
  private_subnets  = [cidrsubnet(local.vpc_cidr, 4, 2), cidrsubnet(local.vpc_cidr, 4, 3)]
  database_subnets = [cidrsubnet(local.vpc_cidr, 4, 4), cidrsubnet(local.vpc_cidr, 4, 5)]
}

module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "6.7.3" # v6 line — required for AWS provider ~> 6.0

  name = local.name_vpc
  cidr = local.vpc_cidr
  azs  = var.azs # ["ap-southeast-2a", "ap-southeast-2b"]

  public_subnets   = local.public_subnets
  private_subnets  = local.private_subnets
  database_subnets = local.database_subnets

  # Naming for subnets/route tables (optional but keeps AWS console readable)
  public_subnet_names   = local.public_subnet_names
  private_subnet_names  = local.private_subnet_names
  database_subnet_names = local.database_subnet_names

  # --- NAT Gateway ---
  # Without this, private subnets have NO internet access.
  # Needed by the NetBird router (it must reach NetBird relay servers
  # outbound) and by any future private workload (apt, AWS APIs, etc.).
  # single_nat_gateway = true => ONE NAT in the first public subnet,
  # shared by all AZs (~$32/mo). Per-AZ NATs would double the cost.
  enable_nat_gateway = true
  single_nat_gateway = true

  # RDS needs a DB subnet group; database subnets get their own route
  # table with no NAT route (databases don't need outbound internet).
  create_database_subnet_group       = true
  create_database_subnet_route_table = true

  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = local.common_tags
}

# --- Security groups ---
# Pattern: terraform-aws-modules/security-group/aws ~> 5.0
# IMPORTANT: `description` is ForceNew — changing it REPLACES the SG.
# Keep descriptions stable once applied.

module "ec2_sg" {
  source  = "terraform-aws-modules/security-group/aws"
  version = "~> 5.0"

  name        = local.name_sg_ec2
  description = "Common EC2 SG for ${var.project_name}: SSH + ICMP from VPC"
  vpc_id      = module.vpc.vpc_id # direct module ref — same state

  # ingress_with_cidr_blocks = list of rules; cidr_blocks accepts
  # module.vpc.vpc_cidr_block (a string "10.42.0.0/16")
  ingress_with_cidr_blocks = [
    {
      from_port   = 22
      to_port     = 22
      protocol    = "tcp"
      cidr_blocks = module.vpc.vpc_cidr_block
      description = "SSH from within VPC (incl. NetBird routing peer)"
    },
    {
      from_port   = -1 # -1/-1 = all ports for ICMP
      to_port     = -1
      protocol    = "icmp"
      cidr_blocks = module.vpc.vpc_cidr_block
      description = "All ICMP from within VPC"
    }
  ]
  # Egress: module default allows all outbound — fine for instances
  # behind NAT / with public IPs.

  tags = merge(local.common_tags, { Name = local.name_sg_ec2 })
}

module "app_sg" {
  source  = "terraform-aws-modules/security-group/aws"
  version = "~> 5.0"

  name        = local.name_sg_app
  description = "App SG for ${var.project_name}: HTTPS from VPC"
  vpc_id      = module.vpc.vpc_id

  ingress_with_cidr_blocks = [
    {
      from_port   = 443
      to_port     = 443
      protocol    = "tcp"
      cidr_blocks = module.vpc.vpc_cidr_block
      description = "HTTPS from within VPC"
    }
  ]

  tags = merge(local.common_tags, { Name = local.name_sg_app })
}

module "rds_sg" {
  source  = "terraform-aws-modules/security-group/aws"
  version = "~> 5.0"

  name        = local.name_sg_rds
  description = "RDS SG for ${var.project_name}: PostgreSQL from VPC"
  vpc_id      = module.vpc.vpc_id

  ingress_with_cidr_blocks = [
    {
      from_port   = 5432
      to_port     = 5432
      protocol    = "tcp"
      cidr_blocks = module.vpc.vpc_cidr_block
      description = "PostgreSQL from VPC (incl. NetBird routing peer)"
    }
  ]

  tags = merge(local.common_tags, { Name = local.name_sg_rds })
}

# outputs.tf exports everything consumers need:
# vpc_id, vpc_cidr_block, public/private/database subnets,
# database_subnet_group, and ec2_sg_*/app_sg_*/rds_sg_* (id/name/arn).
