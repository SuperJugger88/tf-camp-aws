project_name = "tf-learn"

# Globally unique bucket name that stores ALL terraform state files.
s3_bucket_name = "tf-state-andrei-ivanov-2026"

# Remote state for stacks/iam (Principal ARN for the bucket policy).
state_bucket  = "tf-state-andrei-ivanov-2026"
iam_state_key = "learning/iam/terraform.tfstate"
aws_region    = "ap-southeast-2"
aws_profile   = "terraform-aws"

tags = {
  Environment = "dev"
}
