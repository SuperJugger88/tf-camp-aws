# Annotated example of stacks/ec2/main.tf

# --- Key pair ---
# Created once; the public key lives in files/ssh_default.pub at repo root.
module "key_pair" {
  source  = "terraform-aws-modules/key-pair/aws"
  version = "~> 2.0"

  key_name   = local.key_name # coalesce(var.key_name, "<project>-default")
  public_key = file("${path.module}/../../files/ssh_default.pub")

  tags = local.common_tags
}

# --- App instance (public subnet, public IP) ---
module "app" {
  source  = "terraform-aws-modules/ec2-instance/aws"
  version = "~> 6.0"

  name          = local.name_ec2_app # coalesce(var.instance_name, ...)
  instance_type = var.instance_type  # t3.micro — shared with router
  key_name      = module.key_pair.key_pair_name

  # Public subnet + auto-assign public IP: reachable from the internet
  # directly AND through NetBird. If you only need NetBird access,
  # you could move it to private_subnets[0] (internet via NAT).
  subnet_id                   = data.terraform_remote_state.network.outputs.public_subnets[0]
  vpc_security_group_ids      = [
    data.terraform_remote_state.network.outputs.ec2_sg_id, # SSH + ICMP
    data.terraform_remote_state.network.outputs.app_sg_id, # HTTPS 443
  ]
  associate_public_ip_address = true
  monitoring                  = false # CloudWatch detailed monitoring off

  # AMI resolution: var.ami override -> data.aws_ami (latest Ubuntu 24.04
  # matching var.ami_name_filter, owner = Canonical 099720109477)
  ami = coalesce(var.ami, data.aws_ami.ubuntu.id)

  tags = merge(local.common_tags, { Name = local.name_ec2_app })
}

# --- NetBird routing peer (private subnet, NO public IP) ---
module "netbird_router" {
  source  = "terraform-aws-modules/ec2-instance/aws"
  version = "~> 6.0"

  name          = local.name_netbird_router # "<project>-netbird-router"
  instance_type = var.instance_type
  key_name      = module.key_pair.key_pair_name
  ami           = coalesce(var.ami, data.aws_ami.ubuntu.id)

  # Private subnet: outbound internet via the NAT Gateway created in
  # stacks/network. Peers reach it through WireGuard — no public IP needed.
  subnet_id              = data.terraform_remote_state.network.outputs.private_subnets[0]
  vpc_security_group_ids = [data.terraform_remote_state.network.outputs.ec2_sg_id]

  # CRITICAL for a router: disable AWS source/dest check so the instance
  # forwards packets not addressed to itself.
  source_dest_check = false
  monitoring        = false

  # Boot script: install NetBird agent and enroll with the setup key
  # from the netbird-network stack's remote state.
  user_data = <<-EOT
    #!/bin/bash
    set -euo pipefail
    curl -fsSL https://pkgs.netbird.io/install.sh | sh
    netbird up --setup-key '${data.terraform_remote_state.netbird_network.outputs.setup_key}' --hostname '${local.name_netbird_router}'
  EOT

  # If setup_key (or the script) changes -> Terraform REPLACES the instance.
  # Needed because user_data only applies at first boot.
  user_data_replace_on_change = true

  tags = merge(local.common_tags, { Name = local.name_netbird_router })
}

# outputs.tf: instance_id/public_ip/private_ip/key_name for the app,
# netbird_router_instance_id/private_ip/public_ip for the router.
