project_name = "tf-learn"

db_name     = "appdb"
db_username = "app_admin"

engine               = "postgres"
engine_version       = "15.19"
family               = "postgres15"   # parameter group family, must match engine
instance_class       = "db.t3.micro"
allocated_storage    = 20
max_allocated_storage = 100            # storage autoscaling ceiling
storage_encrypted    = true
storage_type         = "gp3"
port                 = 5432

manage_master_user_password = true     # password stored in Secrets Manager
publicly_accessible          = false   # reachable only via NetBird
multi_az                     = false

deletion_protection     = false
skip_final_snapshot     = true
backup_retention_period = 1            # Free Tier max
backup_window           = "03:00-04:00"
maintenance_window      = "sun:04:00-sun:05:00"

# snapshot_identifier = "my-snapshot"  # restore from snapshot

tags = {
  Environment = "dev"
}
