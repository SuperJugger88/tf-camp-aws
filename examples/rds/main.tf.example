# Annotated example of stacks/rds/main.tf

module "postgres" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.0"

  identifier = local.name_rds_pg # "<project>-rds-postgres"

  # --- Engine ---
  engine            = var.engine          # "postgres"
  engine_version    = var.engine_version  # "15.19" — pin it
  family            = var.family          # "postgres15" parameter group
  instance_class    = var.instance_class  # db.t3.micro (Free Tier eligible)
  allocated_storage = var.allocated_storage        # 20 GB
  max_allocated_storage = var.max_allocated_storage # autoscaling ceiling 100 GB
  storage_encrypted = var.storage_encrypted        # true — keep it
  storage_type      = var.storage_type             # gp3

  # --- Database ---
  db_name  = var.db_name     # "appdb"
  username = var.db_username # "app_admin"
  port     = var.port        # "5432" — matches rds_sg ingress rule

  # Password generated by RDS and stored in Secrets Manager.
  # Output rds_master_user_secret_arn points to it — fetch with:
  #   aws secretsmanager get-secret-value --secret-id <arn>
  manage_master_user_password = var.manage_master_user_password

  # --- Network (all from network remote state) ---
  vpc_security_group_ids = [data.terraform_remote_state.network.outputs.rds_sg_id]
  db_subnet_group_name   = data.terraform_remote_state.network.outputs.database_subnet_group
  publicly_accessible    = var.publicly_accessible # false — NetBird only
  multi_az               = var.multi_az            # false — no standby replica

  # --- Lifecycle ---
  snapshot_identifier     = var.snapshot_identifier # null, or restore source
  deletion_protection     = var.deletion_protection # false for learning
  skip_final_snapshot     = var.skip_final_snapshot # true — no snapshot on destroy
  backup_retention_period = var.backup_retention_period # 1 (Free Tier max)
  backup_window           = var.backup_window           # "03:00-04:00" UTC
  maintenance_window      = var.maintenance_window      # "sun:04:00-sun:05:00" UTC

  tags = merge(local.common_tags, { Name = local.name_rds_pg })
}

# outputs.tf: rds_endpoint (host:port), rds_arn, rds_master_user_secret_arn,
# rds_username.
# Connect through NetBird: psql "host=<endpoint> port=5432 dbname=appdb
#   user=app_admin" — password from Secrets Manager.
# NOTE: your laptop must be in the tf-learn-rds-clients NetBird group
# to reach the rds-cidr route.
