# Annotated example of stacks/s3/main.tf

module "tf_state" {
  source  = "terraform-aws-modules/s3-bucket/aws"
  version = "~> 5.0"

  bucket        = var.s3_bucket_name # "tf-state-andrei-ivanov-2026"
  force_destroy = true              # DANGER: allows destroy with objects.
                                    # Fine for learning; remove for prod.

  # Ownership: BucketOwnerEnforced = ACLs fully disabled, access via
  # bucket policy / IAM only (recommended default).
  control_object_ownership = true
  object_ownership         = "BucketOwnerEnforced"

  # Public access block — all four flags true.
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true

  # Default encryption at rest (SSE-S3, no KMS key management needed).
  server_side_encryption_configuration = {
    rule = {
      apply_server_side_encryption_by_default = {
        sse_algorithm = "AES256" # or "aws:kms" for CMK
      }
    }
  }

  # Versioning: protects state files from accidental overwrite/corruption.
  versioning = {
    enabled = true
  }

  # Bucket policy: only the Terraform admin principal may touch objects.
  attach_policy = true
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "AllowTerraformAdminObjects"
        Effect = "Allow"
        Principal = {
          AWS = var.s3_policy_principal_arn
        }
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
        ]
        Resource = ["arn:aws:s3:::${var.s3_bucket_name}/*"]
      },
      {
        Sid    = "AllowTerraformAdminList"
        Effect = "Allow"
        Principal = {
          AWS = var.s3_policy_principal_arn
        }
        Action   = ["s3:ListBucket"]
        Resource = ["arn:aws:s3:::${var.s3_bucket_name}"]
      },
    ]
  })

  tags = merge(local.common_tags, { Name = var.s3_bucket_name })
}

# outputs.tf: s3_bucket_id, s3_bucket_arn.
# NOTE: if the bucket already exists but isn't in state (e.g. created
# manually or state was lost), import it instead of applying:
#   terraform import 'module.tf_state.aws_s3_bucket.this[0]' <bucket-name>
